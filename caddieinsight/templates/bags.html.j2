{% extends "layout.html.j2" %}
{% from "macros.html.j2" import corners, ladder %}
{% block title %}The bag rack{% endblock %}
{% block content %}
<section class="ci-section">
  <p class="ci-eyebrow"><a href="/clubhouse">← The clubhouse</a></p>
  <h1 class="ci-h2">The bag rack.</h1>
  <p class="ci-section__lead">
    Members who share their bag. Yours joins the rack from
    <a href="/settings">settings</a> — sharing is opt-in, always.
  </p>

  {% if not racks %}
  <p class="ci-finehint">The rack is empty — nobody is sharing yet.</p>
  {% endif %}

  <div class="ci-grid ci-grid--2">
    {% for member, rungs in racks %}
    <article class="ci-card ci-rack">{{ corners() }}
      <h2><a href="/clubhouse/bags/{{ member.id }}">{{ member.display_name }}</a></h2>
      {% if member.home_course %}<p class="ci-rack__course">{{ member.home_course }}</p>{% endif %}
      {% if rungs %}
      {{ ladder(rungs[:5], rungs[0].number.carry) }}
      {% if rungs|length > 5 %}
      <p class="ci-finehint">+ {{ rungs|length - 5 }} more measured clubs</p>
      {% endif %}
      {% else %}
      <p class="ci-finehint">No measured carries yet.</p>
      {% endif %}
    </article>
    {% endfor %}
  </div>
</section>
{% endblock %}
