{% extends "layout.html.j2" %}
{% from "macros.html.j2" import corners %}
{% block title %}Clubhouse{% endblock %}
{% block content %}
<section class="ci-section">
  <div class="ci-pagehead">
    <div>
      <p class="ci-eyebrow">The clubhouse</p>
      <h1 class="ci-h2">Bags, not rounds.</h1>
    </div>
    <div class="ci-pagehead__side">
      <a class="ci-pagehead__link" href="/clubhouse/bags">The bag rack
        {% if shared %}<span class="ci-mono">({{ shared|length }})</span>{% endif %}</a>
    </div>
  </div>

  <form class="ci-card ci-form" method="post" action="/clubhouse/post">{{ corners() }}
    <label>Say something
      <textarea name="body" rows="3" maxlength="500" required
                placeholder="Closed the 100-yard gap: the 7-wood carries 196 and the 3-hybrid is out of the bag."></textarea>
    </label>
    <button class="ci-btn" type="submit">Post</button>
  </form>

  {% if not posts %}
  <p class="ci-finehint">Quiet in here. First post gets the honours.</p>
  {% endif %}

  <ul class="ci-feed">
    {% for post in posts %}
    <li class="ci-card ci-post">{{ corners() }}
      <p class="ci-post__meta">
        <strong>{{ post.author }}</strong>
        <span>{{ post.created_at|ago }}</span>
        {% if post.author_shares_bag %}
        <a class="ci-post__bag" href="/clubhouse/bags/{{ post.user_id }}">View bag</a>
        {% endif %}
      </p>
      <p class="ci-post__body">{{ post.body }}</p>
      <div class="ci-post__actions">
        <form method="post" action="/clubhouse/p/{{ post.id }}/tap">
          <button class="ci-linkbtn{% if post.tapped_by_me %} is-tapped{% endif %}" type="submit">
            Tip of the cap · <span class="ci-mono">{{ post.taps }}</span>
          </button>
        </form>
        <a href="/clubhouse/p/{{ post.id }}">Comments · <span class="ci-mono">{{ post.comments }}</span></a>
      </div>
    </li>
    {% endfor %}
  </ul>
</section>
{% endblock %}
