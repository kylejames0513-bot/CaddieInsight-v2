{% extends "layout.html.j2" %}
{% from "macros.html.j2" import corners %}
{% block title %}Sign in{% endblock %}
{% block content %}
<section class="ci-section ci-section--narrow">
  <p class="ci-eyebrow">Members</p>
  <h1 class="ci-h2">Sign in.</h1>
  <form class="ci-card ci-form" method="post" action="/login">{{ corners() }}
    <input type="hidden" name="next" value="{{ request_next|default('') }}">
    <label>Email
      <input name="email" type="email" required autocomplete="email">
    </label>
    <label>Password
      <input name="password" type="password" required autocomplete="current-password">
    </label>
    <button class="ci-btn" type="submit">Sign in</button>
    <p class="ci-form__foot">New here? <a href="/signup">Start your bag</a>.</p>
  </form>
</section>
{% endblock %}
